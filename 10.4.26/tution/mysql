-- Useful views
CREATE OR REPLACE VIEW v_student_summary AS
 SELECT s.id, s.name, s.grade,
        COUNT(e.id) AS courses_enrolled,
        COALESCE(SUM(p.amount),0) AS total_paid
 FROM students s
 LEFT JOIN enrollments e ON e.student_id = s.id
 LEFT JOIN payments p    ON p.enrollment_id = e.id
 GROUP BY s.id, s.name, s.grade;

CREATE OR REPLACE VIEW v_course_revenue AS
 SELECT c.id, c.name, c.subject, t.name AS teacher,
        COUNT(e.id) AS students,
        COALESCE(SUM(p.amount),0) AS revenue
 FROM courses c
 LEFT JOIN teachers t ON t.id = c.teacher_id
 LEFT JOIN enrollments e ON e.course_id = c.id
 LEFT JOIN payments p  ON p.enrollment_id = e.id
 GROUP BY c.id, c.name, c.subject, t.name;

CREATE OR REPLACE VIEW v_teacher_summary AS
 SELECT t.id, t.name, t.subject,
        COUNT(c.id) AS courses_taught,
        COALESCE(SUM(p.amount),0) AS total_earned
 FROM teachers t
 LEFT JOIN courses c ON c.teacher_id = t.id
 LEFT JOIN enrollments e ON e.course_id = c.id
 LEFT JOIN payments p  ON p.enrollment_id = e.id
 GROUP BY t.id, t.name, t.subject;